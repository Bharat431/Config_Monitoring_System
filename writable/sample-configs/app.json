{
    "app": {
        "name": "Config Monitor Demo",
        "version": "1.0.5901",
        "debug": false
    },
    "server": {
        "host": "0.0.0.0",
        "port": 8080,
        "timeout": 26,
        "tls": {
            "enabled": true,
            "min_version": "1.2"
        }
    },
    "features": {
        "new_dashboard": false,
        "beta_api": false
    },
    "database": {
        "driver": "mysql",
        "host": "127.0.0.1",
        "port": 3306,
        "pool": {
            "min": 2,
            "max": 11
        }
    },
    "integrations": [
        "slack",
        "teams"
    ],
    "observability": {
        "metrics": "prometheus",
        "sample": 59.01
    }
}
