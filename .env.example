#--------------------------------------------------------------------
# Configuration Change Monitoring System - environment template
#
# Copy to `.env` and edit. Every CONFIGMON_* setting maps to
# app/Config/Monitor.php. Values are read at boot, so restart daemons
# after changing them.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Local default is SQLite (no server needed). For MySQL / docker:
database.defaultGroup = mysql
database.mysql.hostname = db
database.mysql.database = configmon
database.mysql.username = configmon
database.mysql.password = change-me
database.mysql.port = 3306

# ------------------------------------------------------------------
# API security
# ------------------------------------------------------------------
# When set, all /api/* management routes require `X-API-Key: <value>`.
# Leave empty only in trusted development environments.
CONFIGMON_API_KEY =

# ------------------------------------------------------------------
# Watcher
# ------------------------------------------------------------------
# Comma separated allow-list of directories that may be watched.
# Defaults to writable/sample-configs when empty.
CONFIGMON_WATCH_ROOTS =
CONFIGMON_ALLOWED_EXTENSIONS = env,json,yaml,yml,properties

# Poll cadence and debounce window in milliseconds.
CONFIGMON_POLL_INTERVAL_MS = 2000
CONFIGMON_DEBOUNCE_MS = 750

# Safety limits.
CONFIGMON_MAX_FILE_BYTES = 2097152
CONFIGMON_SNAPSHOT_RETENTION = 20

# Horizontal scale-out: run N watcher processes and give each a shard.
# Example: CONFIGMON_WATCHER_SHARDS=4 with --shard=1..4 per process.
CONFIGMON_WATCHER_SHARD = 1
CONFIGMON_WATCHER_SHARDS = 1

# ------------------------------------------------------------------
# Queue / delivery
# ------------------------------------------------------------------
CONFIGMON_QUEUE_BATCH_SIZE = 25
CONFIGMON_QUEUE_MAX_ATTEMPTS = 6
CONFIGMON_QUEUE_BASE_DELAY_MS = 1000
CONFIGMON_QUEUE_MAX_DELAY_MS = 300000
CONFIGMON_QUEUE_VISIBILITY_TIMEOUT_SEC = 120
CONFIGMON_HTTP_TIMEOUT_SEC = 5

# Circuit breaker.
CONFIGMON_CIRCUIT_FAILURE_THRESHOLD = 5
CONFIGMON_CIRCUIT_COOLDOWN_SEC = 60

# ------------------------------------------------------------------
# Webhook target
# ------------------------------------------------------------------
# Used by `php spark monitor:demo` to create the default target.
CONFIGMON_WEBHOOK_URL =
CONFIGMON_WEBHOOK_SECRET =
CONFIGMON_WEBHOOK_TOKEN =

# Allow loopback/private destinations (local sink, docker network).
# Keep false in production to block SSRF.
CONFIGMON_ALLOW_PRIVATE_WEBHOOKS = false

# Optional host allow-list (comma separated), in addition to SSRF checks.
CONFIGMON_WEBHOOK_ALLOWED_HOSTS =

# ------------------------------------------------------------------
# Demo mode (never enable in production)
# ------------------------------------------------------------------
CONFIGMON_DEMO_MODE = false

# ------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------
CONFIGMON_LOG_LEVEL = info
CONFIGMON_LOG_TO_STDERR = true
CONFIGMON_TRACING_ENABLED = true
CONFIGMON_METRICS_NAMESPACE = configmon

# ------------------------------------------------------------------
# Housekeeping
# ------------------------------------------------------------------
CONFIGMON_RETENTION_DAYS = 30
